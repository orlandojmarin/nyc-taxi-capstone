<mxfile host="app.diagrams.net">
  <diagram name="Pattern B - ETL Engine-Side Transform" id="pattern-b">
    <mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Architecture: Pattern B - ETL Engine-Side Transform Pipeline" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=18;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="450" y="15" width="750" height="35" as="geometry" />
        </mxCell>

        <!-- ZONE BACKGROUNDS -->
        <mxCell id="z_source" value="DATA SOURCE" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontColor=#B22222;fillColor=#FFF8F0;strokeColor=#DDD8D2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="70" width="190" height="540" as="geometry" />
        </mxCell>
        <mxCell id="z_transform" value="TRANSFORM (Engine-Side)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontColor=#E65100;fillColor=#FFF3E0;strokeColor=#DDD8D2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="250" y="70" width="280" height="540" as="geometry" />
        </mxCell>
        <mxCell id="z_conformed" value="S3 CONFORMED" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontColor=#795548;fillColor=#FFF5EE;strokeColor=#DDD8D2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="70" width="220" height="540" as="geometry" />
        </mxCell>
        <mxCell id="z_silver" value="SILVER (Snowflake)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontColor=#1565C0;fillColor=#F0F8FF;strokeColor=#DDD8D2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="810" y="70" width="240" height="540" as="geometry" />
        </mxCell>
        <mxCell id="z_gold" value="GOLD (Snowflake)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontColor=#2E7D32;fillColor=#F0FFF0;strokeColor=#DDD8D2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1080" y="70" width="260" height="540" as="geometry" />
        </mxCell>
        <mxCell id="z_serve" value="SERVE" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontColor=#6A1B9A;fillColor=#F5F0FF;strokeColor=#DDD8D2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1370" y="70" width="200" height="540" as="geometry" />
        </mxCell>

        <!-- ============ DATA SOURCE ============ -->

        <mxCell id="src_yellow" value="s3://techcatalyst-de-2026/&#10;raw/yellow_taxi/&#10;(10 Parquet, ~33M rows)" style="shape=document;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B22222;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="170" height="65" as="geometry" />
        </mxCell>

        <mxCell id="src_green" value="s3://techcatalyst-de-2026/&#10;raw/green_taxi/&#10;(10 Parquet, ~600K rows)" style="shape=document;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B22222;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="170" height="65" as="geometry" />
        </mxCell>

        <mxCell id="src_lookup" value="s3://techcatalyst-de-2026/&#10;raw/taxi_lookup/&#10;taxi_zone_lookup.csv" style="shape=document;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B22222;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="170" height="60" as="geometry" />
