        </mxCell>

        <!-- ============ ARROWS: Source → Transform ============ -->

        <mxCell id="a_yellow_engine" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#E65100;strokeWidth=2;" edge="1" parent="1" source="src_yellow" target="engine_box">
          <mxGeometry relative="1" as="geometry" />
