        <mxCell id="src_label" value="S3 RAW Bucket&#10;(read-only, provided)" style="text;html=1;align=center;fontSize=9;fontColor=#B22222;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="50" y="410" width="150" height="25" as="geometry" />
        </mxCell>

        <!-- ============ TRANSFORM (Engine-Side) ============ -->

        <mxCell id="engine_box" value="Polars / pandas / PySpark&#10;(running on SageMaker VM)&#10;&#10;• Read Parquet via scan_parquet&#10;  (lazy evaluation for memory)&#10;• Union Yellow + Green&#10;• Rename lpep/tpep timestamps&#10;• Add taxi_type column&#10;• Filter impossible values&#10;• Apply typing and derived columns&#10;• Handle schema reconciliation&#10;• Write partitioned Parquet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="265" y="110" width="250" height="190" as="geometry" />
        </mxCell>

        <mxCell id="engine_note" value="OR: AWS Glue&#10;(Serverless Spark)&#10;&#10;• Native S3 access&#10;• Scales without managing infra&#10;• Good for distributed processing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;align=left;spacingLeft=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="265" y="330" width="250" height="100" as="geometry" />
        </mxCell>

        <mxCell id="engine_choice" value="Engine choice depends on&#10;team skill and data volume.&#10;Polars recommended for local." style="text;html=1;align=center;fontSize=9;fontColor=#E65100;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="275" y="450" width="230" height="35" as="geometry" />
        </mxCell>

        <!-- ============ S3 CONFORMED ============ -->

        <mxCell id="conf_trips" value="s3://[team-bucket]/&#10;conformed/trips/&#10;&#10;Partitioned Parquet&#10;year=YYYY/month=MM/&#10;&#10;Cleaned, unioned,&#10;schema-reconciled&#10;~33.6M rows" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#795548;fontSize=10;size=10;" vertex="1" parent="1">
