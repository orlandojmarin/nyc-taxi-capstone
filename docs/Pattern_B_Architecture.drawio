          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a_conf_sf_lbl" value="External stage&#10;+ COPY INTO" style="edgeLabel;html=1;fontSize=9;fontColor=#1565C0;" vertex="1" connectable="0" parent="a_conf_sf">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- ============ ARROWS: Silver → Gold ============ -->

        <mxCell id="a_slv_gld" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2E7D32;strokeWidth=2;" edge="1" parent="1" source="slv_trips" target="gld_trips">
          <mxGeometry relative="1" as="geometry" />
