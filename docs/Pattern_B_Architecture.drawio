        </mxCell>

        <!-- ============ SUMMARY ============ -->

        <mxCell id="summary" value="PATTERN B SUMMARY: ETL engine-side transform. Raw Parquet files are read directly from S3 by a DataFrame engine (Polars recommended for local, AWS Glue for distributed). Cleaning, unioning, schema reconciliation, and partitioning happen outside the warehouse, producing a conformed Parquet zone in a team-owned S3 prefix. The conformed data is then loaded into Snowflake Silver via external stage + COPY INTO. dbt Core builds Gold mart models (tables) for joins, aggregations, and year-over-year analysis. Demonstrates DataFrame skill, file format/partitioning knowledge, and keeps heavy row-level cleaning off Snowflake credits. More moving parts than Pattern A but broader skill demonstration." style="text;html=1;align=left;verticalAlign=top;fontSize=9;fontColor=#444444;spacingLeft=5;spacingRight=5;" vertex="1" parent="1">
          <mxGeometry x="30" y="780" width="1540" height="50" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
