          <mxGeometry x="835" y="320" width="190" height="60" as="geometry" />
        </mxCell>

        <mxCell id="slv_note" value="Data arrives pre-cleaned;&#10;Snowflake is the queryable&#10;warehouse layer" style="text;html=1;align=center;fontSize=9;fontColor=#1565C0;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="840" y="410" width="180" height="35" as="geometry" />
