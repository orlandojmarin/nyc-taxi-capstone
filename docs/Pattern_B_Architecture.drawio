        <mxCell id="conf_lookup" value="s3://[team-bucket]/&#10;conformed/lookup/&#10;zone_lookup.parquet" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#795548;fontSize=10;size=10;" vertex="1" parent="1">
