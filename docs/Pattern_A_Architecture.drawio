        <mxCell id="src_green" value="s3://techcatalyst-de-2026/&#10;raw/green_taxi/&#10;(10 Parquet files, ~600K rows)" style="shape=document;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B22222;fontSize=10;align=center;" vertex="1" parent="1">
