        </mxCell>

        <mxCell id="a_slv_gld_lbl" value="dbt mart models&#10;(join, aggregate, model)" style="edgeLabel;html=1;fontSize=9;fontColor=#2E7D32;" vertex="1" connectable="0" parent="a_slv_gld_trips">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- ============ ARROWS: Gold → Serve ============ -->

