        </mxCell>

        <mxCell id="slv_transforms" value="Transformations:&#10;• Union Yellow + Green&#10;• Rename lpep/tpep timestamps&#10;• Add taxi_type, trip_duration&#10;• Add day_of_week, hour, month, year&#10;• Filter impossible values&#10;• dbt tests: not_null, unique,&#10;  accepted_values, relationships" style="text;html=1;align=left;fontSize=9;fontColor=#1565C0;" vertex="1" parent="1">
