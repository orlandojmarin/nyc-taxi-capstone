          <mxGeometry x="520" y="670" width="160" height="45" as="geometry" />
        </mxCell>
        <mxCell id="task3" value="Step 3: dbt test&#10;+ row count reconciliation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#455A64;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="740" y="670" width="180" height="45" as="geometry" />
