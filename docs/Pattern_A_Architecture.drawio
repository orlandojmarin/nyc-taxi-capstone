        <mxCell id="src_lookup" value="s3://techcatalyst-de-2026/&#10;raw/taxi_lookup/&#10;taxi_zone_lookup.csv&#10;(265 zones)" style="shape=document;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B22222;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="55" y="340" width="170" height="70" as="geometry" />
