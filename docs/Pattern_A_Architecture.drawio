<mxfile host="app.diagrams.net">
  <diagram name="Pattern A - ELT Warehouse-Centric" id="pattern-a">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Architecture: Pattern A - ELT Warehouse-Centric Pipeline" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=18;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="450" y="15" width="700" height="35" as="geometry" />
        </mxCell>

        <!-- ZONE BACKGROUNDS -->
        <mxCell id="z_source" value="DATA SOURCE" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontColor=#B22222;fillColor=#FFF8F0;strokeColor=#DDD8D2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="200" height="520" as="geometry" />
        </mxCell>
        <mxCell id="z_bronze" value="BRONZE (Raw Landing)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontColor=#8B4513;fillColor=#FFF5EE;strokeColor=#DDD8D2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="70" width="260" height="520" as="geometry" />
        </mxCell>
        <mxCell id="z_silver" value="SILVER (Cleaned, Conformed)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontColor=#1565C0;fillColor=#F0F8FF;strokeColor=#DDD8D2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="70" width="280" height="520" as="geometry" />
