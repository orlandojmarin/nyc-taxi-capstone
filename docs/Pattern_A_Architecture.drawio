        <!-- ============ DATA SOURCE ============ -->

        <mxCell id="src_yellow" value="s3://techcatalyst-de-2026/&#10;raw/yellow_taxi/&#10;(10 Parquet files, ~33M rows)" style="shape=document;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B22222;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="55" y="120" width="170" height="70" as="geometry" />
