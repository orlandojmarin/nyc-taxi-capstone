        <mxCell id="task1" value="Step 1: Create Stage&#10;+ COPY INTO bronze" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#455A64;fontSize=10;" vertex="1" parent="1">
