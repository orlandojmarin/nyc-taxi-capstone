        <mxCell id="gld_trips" value="TECHCATALYST.MARTS.&#10;fct_trips&#10;&#10;Fact table: one row per trip&#10;Joined to zones&#10;Derived metrics&#10;Year-over-year ready" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=10;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="920" y="150" width="240" height="110" as="geometry" />
