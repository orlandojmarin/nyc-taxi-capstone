        <mxCell id="z_gold" value="GOLD (Marts)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontColor=#2E7D32;fillColor=#F0FFF0;strokeColor=#DDD8D2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="900" y="70" width="280" height="520" as="geometry" />
