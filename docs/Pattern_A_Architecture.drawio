          <mxGeometry x="1230" y="587" width="180" height="14" as="geometry" />
        </mxCell>
        <mxCell id="legend_serve" value="━━ Serving (purple)" style="text;html=1;align=left;fontSize=9;fontColor=#6A1B9A;" vertex="1" parent="1">
          <mxGeometry x="1230" y="603" width="180" height="14" as="geometry" />
        </mxCell>

        <!-- ============ SUMMARY ============ -->

        <mxCell id="summary" value="PATTERN A SUMMARY: ELT warehouse-centric. Raw Parquet files from S3 are loaded directly into Snowflake Bronze tables via an external stage and COPY INTO. All transformation happens inside Snowflake via dbt Core: staging models (views) union Yellow and Green, reconcile schemas, and apply cleaning. Mart models (tables) join zones, derive metrics, and produce year-over-year aggregations for the dashboard. Orchestration is a single re-runnable Python script. Fewest moving parts, all logic in SQL, every transformation tested by dbt." style="text;html=1;align=left;verticalAlign=top;fontSize=9;fontColor=#444444;spacingLeft=5;spacingRight=5;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="1380" height="40" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
