        <mxCell id="brz_yellow" value="TECHCATALYST.BRONZE.&#10;yellow_raw&#10;(Delta/table, ~33M rows)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#795548;fontSize=10;size=10;" vertex="1" parent="1">
