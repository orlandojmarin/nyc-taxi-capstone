          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a_green_stage" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#E65100;strokeWidth=2;" edge="1" parent="1" source="src_green" target="stage_box">
          <mxGeometry relative="1" as="geometry" />
