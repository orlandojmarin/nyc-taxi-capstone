        <mxCell id="a_brz_slv_lbl" value="dbt staging models&#10;(union, clean, type)" style="edgeLabel;html=1;fontSize=9;fontColor=#1565C0;" vertex="1" connectable="0" parent="a_brzy_slv">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- ============ ARROWS: Silver → Gold ============ -->

        <mxCell id="a_slv_gld_trips" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2E7D32;strokeWidth=2;" edge="1" parent="1" source="slv_trips" target="gld_trips">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a_slv_gld_zones" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2E7D32;strokeWidth=1.5;" edge="1" parent="1" source="slv_zones" target="gld_zones">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a_gld_trips_yoy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#F57F17;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="gld_trips" target="gld_yoy">
